# Admin credentials used by the /login page.
# These are baked into the static build; rotate them by rebuilding.
VITE_ADMIN_EMAIL=admin@portfolio.com
VITE_ADMIN_PASSWORD=Admin@2024

# Base path for the built assets.
# Use "/" for a generic React deploy at the site root (Netlify, Vercel, S3, …)
# or "/<repo-name>/" for GitHub Pages under a project subpath.
VITE_BASE_PATH=/
